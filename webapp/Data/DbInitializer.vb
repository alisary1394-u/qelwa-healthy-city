        End Function

        Public Function HashPassword(password As String) As String
            Using sha = SHA256.Create()
                Dim bytes = sha.ComputeHash(Encoding.UTF8.GetBytes(password))
                Return BitConverter.ToString(bytes).Replace("-", "").ToLower()
            End Using
        End Function

    End Module

