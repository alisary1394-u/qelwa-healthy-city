@page
@model BudgetModel
@{
    ViewData["Title"] = "الميزانية";
    ViewData["ActivePage"] = "Budget";
    var totalIncome = Model.Transactions.Where(t => t.Type == "income" && t.Status == "approved").Sum(t => t.TotalAmount);
    var totalExpense = Model.Transactions.Where(t => t.Type == "expense" && t.Status == "approved").Sum(t => t.TotalAmount);
    var balance = totalIncome - totalExpense;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cash-stack text-success me-2"></i>الميزانية</h2>
        <p class="text-muted mb-0">@Model.Transactions.Count() معاملة مالية</p>
    </div>
</div>

<!-- بطاقات الملخص -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success bg-opacity-10">
            <div class="card-body text-center py-3">
                <div class="text-success mb-1"><i class="bi bi-arrow-down-circle-fill fs-3"></i></div>
                <div class="fs-4 fw-bold text-success">@totalIncome.ToString("N0") <small class="fs-6">ريال</small></div>
                <div class="small text-muted">إجمالي الإيرادات المعتمدة</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-danger bg-opacity-10">
            <div class="card-body text-center py-3">
                <div class="text-danger mb-1"><i class="bi bi-arrow-up-circle-fill fs-3"></i></div>
                <div class="fs-4 fw-bold text-danger">@totalExpense.ToString("N0") <small class="fs-6">ريال</small></div>
                <div class="small text-muted">إجمالي المصروفات المعتمدة</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm @(balance >= 0 ? "bg-primary bg-opacity-10" : "bg-warning bg-opacity-10")">
            <div class="card-body text-center py-3">
                <div class="@(balance >= 0 ? "text-primary" : "text-warning") mb-1"><i class="bi bi-wallet2 fs-3"></i></div>
                <div class="fs-4 fw-bold @(balance >= 0 ? "text-primary" : "text-warning")">@balance.ToString("N0") <small class="fs-6">ريال</small></div>
                <div class="small text-muted">الرصيد الحالي</div>
            </div>
        </div>
    </div>
</div>

<!-- تبويبات -->
<ul class="nav nav-tabs mb-0" id="budgetTabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#allTrans" type="button">جميع المعاملات (@Model.Transactions.Count())</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#expenses" type="button">المصروفات (@Model.Transactions.Count(t => t.Type == "expense"))</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#income" type="button">الإيرادات (@Model.Transactions.Count(t => t.Type == "income"))</button></li>
</ul>

<div class="tab-content">
    @{
        var groups = new[] {
            new { Id = "allTrans", Active = true, Items = Model.Transactions },
            new { Id = "expenses", Active = false, Items = Model.Transactions.Where(t => t.Type == "expense").ToList() },
            new { Id = "income", Active = false, Items = Model.Transactions.Where(t => t.Type == "income").ToList() },
        };
    }
    @foreach (var g in groups)
    {
        <div class="tab-pane fade @(g.Active ? "show active" : "")" id="@g.Id">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3">العنوان</th>
                                    <th class="py-3">النوع</th>
                                    <th class="py-3">الفئة</th>
                                    <th class="py-3">المبلغ</th>
                                    <th class="py-3">ضريبة القيمة المضافة</th>
                                    <th class="py-3">الإجمالي</th>
                                    <th class="py-3">الحالة</th>
                                    <th class="py-3">التاريخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in g.Items)
                                {
                                    <tr>
                                        <td class="px-4 py-3 fw-semibold">@t.Title</td>
                                        <td>
                                            @if (t.Type == "income")
                                            {
                                                <span class="badge bg-success"><i class="bi bi-arrow-down me-1"></i>إيراد</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-arrow-up me-1"></i>مصروف</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@t.Category</td>
                                        <td class="fw-semibold">@t.Amount.ToString("N0") ر</td>
                                        <td class="text-muted small">
                                            @if (t.VatRate > 0)
                                            {
                                                <span>@t.VatRate% (@t.VatAmount.ToString("N0") ر)</span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="fw-bold @(t.Type == "income" ? "text-success" : "text-danger")">@t.TotalAmount.ToString("N0") ر</td>
                                        <td>
                                            @{
                                                var sBadge = t.Status == "approved" ? "success" : t.Status == "rejected" ? "danger" : "warning";
                                            }
                                            <span class="badge bg-@sBadge">@t.StatusLabel</span>
                                        </td>
                                        <td class="text-muted small">@t.TransactionDate.ToString("yyyy/MM/dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
