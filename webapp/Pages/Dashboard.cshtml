@page
@model QelwaApp.Pages.DashboardModel
@{
    ViewData["Title"] = "لوحة التحكم";
    ViewData["Page"] = "Dashboard";
}

@section Breadcrumb {
    <li class="breadcrumb-item active">لوحة التحكم</li>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h1 class="page-title mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>لوحة التحكم</h1>
        <p class="text-muted mb-0">نظرة عامة على حالة معايير المدينة الصحية</p>
    </div>
    <span class="badge bg-primary-subtle text-primary px-3 py-2">
        <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("yyyy/MM/dd")
    </span>
</div>

<!-- إحصاءات رئيسية -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="stat-icon bg-primary bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-clipboard2-check text-primary fs-4"></i>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">معايير</span>
                </div>
                <div class="fw-bold text-dark" style="font-size:2rem">@Model.Stats.TotalStandards</div>
                <div class="text-muted small">إجمالي المعايير</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="stat-icon bg-success bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success">مكتمل</span>
                </div>
                <div class="fw-bold text-dark" style="font-size:2rem">@Model.Stats.CompletedStandards</div>
                <div class="text-muted small">معيار مكتمل</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="stat-icon bg-info bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-graph-up text-info fs-4"></i>
                    </div>
                    <span class="badge bg-info-subtle text-info">إنجاز</span>
                </div>
                <div class="fw-bold text-dark" style="font-size:2rem">@Math.Round(Model.Stats.AvgCompletion, 1)%</div>
                <div class="text-muted small">متوسط الإنجاز</div>
                <div class="progress mt-2" style="height:6px">
                    <div class="progress-bar bg-info" style="width:@Model.Stats.AvgCompletion%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="stat-icon bg-danger bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                    </div>
                    <span class="badge bg-danger-subtle text-danger">تنبيه</span>
                </div>
                <div class="fw-bold text-dark" style="font-size:2rem">@Model.Stats.OverdueTasks</div>
                <div class="text-muted small">مهمة متأخرة</div>
            </div>
        </div>
    </div>
</div>

<!-- الرسوم البيانية -->
<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pb-0">
                <h5 class="card-title mb-0"><i class="bi bi-pie-chart text-primary me-2"></i>توزيع المعايير</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div style="position:relative;height:240px;width:100%;max-width:300px">
                    <canvas id="chartStatus" aria-label="مخطط توزيع المعايير" role="img"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pb-0">
                <h5 class="card-title mb-0"><i class="bi bi-bar-chart text-success me-2"></i>الإنجاز حسب المحاور</h5>
            </div>
            <div class="card-body">
                <canvas id="chartAxes" height="200" aria-label="مخطط الإنجاز حسب المحاور" role="img"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- المحاور -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0"><i class="bi bi-grid-3x3 text-info me-2"></i>المحاور الصحية</h5>
        <a asp-page="/Standards" class="btn btn-sm btn-outline-primary">عرض المعايير <i class="bi bi-arrow-left ms-1"></i></a>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var ax in Model.Axes)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="axis-card card border-0 h-100 p-3" style="border-right:4px solid @ax.Color !important">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-3 p-2 flex-shrink-0" style="background:@(ax.Color)22">
                                <i class="bi @ax.Icon" style="color:@ax.Color;font-size:1.3rem"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold small text-dark mb-1 text-truncate">@ax.Name</div>
                                <div class="d-flex gap-2 mb-2">
                                    <span class="badge bg-secondary-subtle text-secondary small">@ax.Standards.Count معيار</span>
                                    <span class="badge bg-success-subtle text-success small">@ax.Standards.Count(s => s.Status == "completed") مكتمل</span>
                                </div>
                                <div class="progress" style="height:5px">
                                    <div class="progress-bar" style="width:@Math.Round(ax.CompletionPercentage,0)%;background:@ax.Color" role="progressbar"></div>
                                </div>
                                <div class="text-muted mt-1" style="font-size:.72rem">@Math.Round(ax.CompletionPercentage,1)%</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ملخص سريع + مهام متأخرة -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="bi bi-exclamation-triangle text-danger me-2"></i>مهام متأخرة</h5>
                <a asp-page="/Tasks" asp-route-filter="overdue" class="btn btn-sm btn-outline-danger">عرض الكل</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.OverdueTasks.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check-circle text-success fs-3 d-block mb-2"></i>لا توجد مهام متأخرة
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var t in Model.OverdueTasks.Take(5))
                        {
                            <div class="list-group-item border-0 py-3 px-4">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-alarm text-danger mt-1 flex-shrink-0"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-medium small text-truncate">@t.Title</div>
                                        @if (t.DueDate.HasValue)
                                        {
                                            <div class="text-muted" style="font-size:.75rem">استحق: @t.DueDate.Value.ToString("yyyy/MM/dd")</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0">
                <h5 class="card-title mb-0"><i class="bi bi-lightning-charge text-warning me-2"></i>ملخص سريع</h5>
            </div>
            <div class="card-body">
                @{
                    var quickStats = new[] {
                        new { Icon="bi-list-task", Color="primary", Label="المهام المفتوحة", Value=Model.Stats.OpenTasks },
                        new { Icon="bi-check2-all", Color="success", Label="المهام المكتملة", Value=Model.Stats.CompletedTasks },
                        new { Icon="bi-arrow-repeat", Color="warning", Label="معايير قيد التنفيذ", Value=Model.Stats.InProgressStandards },
                        new { Icon="bi-people", Color="info", Label="المستخدمون النشطون", Value=Model.Stats.ActiveUsers }
                    };
                }
                @foreach (var s in quickStats)
                {
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-@(s.Color) bg-opacity-10 p-2">
                                <i class="bi @s.Icon text-@(s.Color)"></i>
                            </div>
                            <span class="small fw-medium text-dark">@s.Label</span>
                        </div>
                        <span class="badge bg-@(s.Color) rounded-pill px-3">@s.Value</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var cd = @Html.Raw(Model.ChartDataJson);
    document.addEventListener('DOMContentLoaded', function() {
        new Chart(document.getElementById('chartStatus').getContext('2d'), {
            type: 'doughnut',
            data: { labels: ['مكتملة','قيد التنفيذ','لم تبدأ'],
                    datasets: [{ data: [cd.completed, cd.inProgress, cd.notStarted],
                                 backgroundColor: ['#10B981','#3B82F6','#9CA3AF'], borderWidth:2, borderColor:'#fff' }] },
            options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } } }
        });
        new Chart(document.getElementById('chartAxes').getContext('2d'), {
            type: 'bar',
            data: { labels: cd.axisLabels,
                    datasets: [{ label:'%', data: cd.axisScores, backgroundColor: cd.axisColors, borderRadius:6 }] },
            options: { responsive:true, indexAxis:'y',
                       plugins:{ legend:{ display:false } },
                       scales:{ x:{ min:0, max:100, ticks:{ callback: v => v+'%' } } } }
        });
    });
</script>
}
