<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - نظام المدينة الصحية | محافظة قلوة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="sidebar-layout">

<!-- ===== SIDEBAR ===== -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="d-flex align-items-center gap-2 px-3 py-3">
            <div class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></div>
            <div>
                <div class="fw-bold lh-1" style="font-size:.9rem">نظام المدينة الصحية</div>
                <div class="opacity-75" style="font-size:.7rem">محافظة قلوة</div>
            </div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-title">القائمة الرئيسية</div>
        <a class="sidebar-link @(ViewData["Page"]?.ToString()=="Dashboard"?"active":"")" asp-page="/Dashboard">
            <i class="bi bi-speedometer2"></i><span>لوحة التحكم</span>
        </a>
        <a class="sidebar-link @(ViewData["Page"]?.ToString()=="Standards"?"active":"")" asp-page="/Standards">
            <i class="bi bi-clipboard2-check"></i><span>المعايير</span>
        </a>
        <a class="sidebar-link @(ViewData["Page"]?.ToString()=="Tasks"?"active":"")" asp-page="/Tasks">
            <i class="bi bi-list-task"></i><span>المهام</span>
        </a>
        <a class="sidebar-link @(ViewData["Page"]?.ToString()=="Reports"?"active":"")" asp-page="/Reports">
            <i class="bi bi-bar-chart-line"></i><span>التقارير</span>
        </a>

        <div class="nav-section-title">الإدارة</div>
        <a class="sidebar-link disabled-link" href="#" title="قريباً">
            <i class="bi bi-lightbulb"></i><span>المبادرات</span>
            <span class="ms-auto badge bg-secondary" style="font-size:.6rem">قريباً</span>
        </a>
        <a class="sidebar-link disabled-link" href="#" title="قريباً">
            <i class="bi bi-currency-dollar"></i><span>الميزانية</span>
            <span class="ms-auto badge bg-secondary" style="font-size:.6rem">قريباً</span>
        </a>
        <a class="sidebar-link disabled-link" href="#" title="قريباً">
            <i class="bi bi-building"></i><span>اللجان</span>
            <span class="ms-auto badge bg-secondary" style="font-size:.6rem">قريباً</span>
        </a>
        <a class="sidebar-link disabled-link" href="#" title="قريباً">
            <i class="bi bi-people"></i><span>الفريق</span>
            <span class="ms-auto badge bg-secondary" style="font-size:.6rem">قريباً</span>
        </a>
        <a class="sidebar-link disabled-link" href="#" title="قريباً">
            <i class="bi bi-geo-alt"></i><span>المسح الميداني</span>
            <span class="ms-auto badge bg-secondary" style="font-size:.6rem">قريباً</span>
        </a>
        <a class="sidebar-link disabled-link" href="#" title="قريباً">
            <i class="bi bi-hand-index-thumb"></i><span>التطوع</span>
            <span class="ms-auto badge bg-secondary" style="font-size:.6rem">قريباً</span>
        </a>
        <a class="sidebar-link disabled-link" href="#" title="قريباً">
            <i class="bi bi-folder2-open"></i><span>الملفات</span>
            <span class="ms-auto badge bg-secondary" style="font-size:.6rem">قريباً</span>
        </a>
        <a class="sidebar-link disabled-link" href="#" title="قريباً">
            <i class="bi bi-gear"></i><span>الإعدادات</span>
            <span class="ms-auto badge bg-secondary" style="font-size:.6rem">قريباً</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="d-flex align-items-center gap-2 px-3 py-2">
            <div class="user-avatar-sm">@(User.Identity?.Name?.Substring(0,1) ?? "م")</div>
            <div class="flex-grow-1 overflow-hidden">
                <div class="small fw-medium text-truncate">@User.Identity?.Name</div>
                <div style="font-size:.7rem;opacity:.6">مدير النظام</div>
            </div>
            <a asp-page="/Account/Logout" class="btn btn-sm btn-outline-light btn-logout" title="تسجيل الخروج">
                <i class="bi bi-box-arrow-left"></i>
            </a>
        </div>
    </div>
</aside>

<!-- ===== MAIN CONTENT ===== -->
<div class="main-content">
    <!-- topbar -->
    <header class="topbar d-flex align-items-center justify-content-between px-4">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-sm btn-icon sidebar-toggle d-lg-none" id="sidebarToggle">
                <i class="bi bi-list fs-5"></i>
            </button>
            <nav aria-label="breadcrumb" class="d-none d-md-block">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-page="/Dashboard" class="text-decoration-none text-muted"><i class="bi bi-house-door"></i> الرئيسية</a></li>
                    @await RenderSectionAsync("Breadcrumb", required: false)
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary small">
                <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("yyyy/MM/dd")
            </span>
        </div>
    </header>

    <!-- alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mx-4 mt-3 mb-0">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-4 mt-3 mb-0">
            <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <main class="page-content">
        @RenderBody()
    </main>
</div>

<!-- sidebar overlay for mobile -->
<div class="sidebar-overlay d-lg-none" id="sidebarOverlay"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="~/js/site.js"></script>
<script>
    // mobile sidebar toggle
    document.getElementById('sidebarToggle')?.addEventListener('click', function() {
        document.getElementById('sidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('show');
    });
    document.getElementById('sidebarOverlay')?.addEventListener('click', function() {
        document.getElementById('sidebar').classList.remove('open');
        this.classList.remove('show');
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
